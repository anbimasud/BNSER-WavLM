*/.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
env/
ENV/
*.env
.env
.env.*
!.env.example

# Local logs
*.log
logs/

# Local model checkpoints / large binary artifacts
checkpoints/
**/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
