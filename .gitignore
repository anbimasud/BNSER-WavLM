# Raw/private speech data and local evaluation archives
# Keep only public, redistributable metadata/statistics in the repository.
data/raw/
data/audio/
data/wav/
data/evaluation/
evaluation/
evaluations/
MODEL_*_Evaluations/

# Local experiment outputs that are not manuscript-facing result tables
# (Manuscript-facing CSVs under results/ are intentionally tracked.)
**/local_outputs/
**/tmp/

# Google Colab / personal-machine paths should never be committed.
# Do not add absolute Drive paths to repository configuration files.

# Office temporary lock files
~$*
